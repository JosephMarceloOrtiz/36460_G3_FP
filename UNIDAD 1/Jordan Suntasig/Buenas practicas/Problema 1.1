 * 1.1 .- Media de dos valores
 * Desarrolla un programa que ingrese dos numeros por teclado e imprima su media
 */

#include <stdio.h>

int main() {
    float num1, num2, media;

    // Entrada de datos
    printf("Ingrese el primer numero: ");
    scanf("%f", &num1);
    
    printf("Ingrese el segundo numero: ");
    scanf("%f", &num2);

    // Procesamiento
    media = (num1 + num2) / 2;

    // Salida
    printf("La media es: %.2f\n", media);

    return 0;
}
