#include <stdio.h>

// FUNCIÓN: Generar Cuadrado Vacío
void generarCuadradoVacio() {
    int n = 0, i, j;

    // Validación estricta: se repite si 'n' es menor o igual a 0 (cero o negativos)
    do {
        printf("\n--- CUADRADO VACIO ---\n");
        printf("Ingresa el lado del cuadrado (mayor a 0): ");
        scanf("%d", &n);

        if (n <= 0) {
            printf("[Aviso] No se permiten numeros negativos ni el cero. Intenta de nuevo.\n");
        }
    } while (n <= 0);

    // Dibuja el cuadrado fila por fila y columna por columna
    for (i = 1; i <= n; i++) {
        for (j = 1; j <= n; j++) {
            if (i == 1 || i == n || j == 1 || j == n) {
                printf("*"); // Bordes superiores, inferiores y laterales
            } else {
                printf(" "); // Centro hueco corregido con llaves
            }
        }
        printf("\n"); // Salto de línea al terminar cada fila
    }
}

// FUNCIÓN: Calcular Serie de Fibonacci
void calcularFibonacci() {
    int n = 0, i;
    long long t1 = 0, t2 = 1, siguiente = 0;

    // Validación estricta: se repite si 'n' es menor o igual a 0
    do {
        printf("\n--- SERIE FIBONACCI ---\n");
        printf("Ingresa la cantidad de terminos (mayor a 0): ");
        scanf("%d", &n);

        if (n <= 0) {
            printf("[Aviso] La cantidad de terminos debe ser mayor a 0. Intenta de nuevo.\n");
        }
    } while (n <= 0);

    printf("Serie: ");
    for (i = 1; i <= n; ++i) {
        if (i == 1) {
            printf("%lld ", t1);
            continue;
        }
        if (i == 2) {
            printf("%lld ", t2);
            continue;
        }
        siguiente = t1 + t2;
        t1 = t2;
        t2 = siguiente;
        printf("%lld ", siguiente);
    }
    printf("\n");
}

int main() {
    int opcion = 0; // Variable para almacenar la opción elegida en el menú

    // Ciclo principal para mantener el menú abierto hasta que el usuario decida salir
    do {
        printf("\n=====================\n");
        printf("    MENU PRINCIPAL   \n");
        printf("=====================\n");
        printf("1.- Cuadrado vacio\n");
        printf("2.- Serie (Fibonacci)\n");
        printf("3.- Salida\n");
        printf("Elige una opcion: ");
        scanf("%d", &opcion); // Lee la opción del usuario

        // Evalúa qué opción eligió el usuario y llama a la función correspondiente
        switch (opcion) {
            case 1:
                generarCuadradoVacio(); // Llama a la función del cuadrado
                break;

            case 2:
                calcularFibonacci(); // Llama a la función de Fibonacci
                break;

            case 3:
                printf("\nFinalizacion del programa\n");
                break;

            default:
                printf("\n[Error] Opcion no valida. Por favor, elige entre 1 y 3.\n");
                break;
        }

    } while (opcion != 3); // El programa se repite mientras la opción sea diferente de 3

    return 0;
}

