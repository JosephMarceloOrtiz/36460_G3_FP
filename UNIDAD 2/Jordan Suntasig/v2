//funcion para el vector
void gestionar_vector() {
    int n;
    int v[MAX];

    printf("\n--- VECTOR DE TAMANO N ---\n");
    //aqui solo se verifica que los datos cumplan con los parametros ya mencionados
    do{
    printf("Ingrese el tamano del vector (1 a %d): ", MAX);
    scanf("%d", &n);
    if (n <= 0 || n > MAX) {
        printf("Error: Tamano no valido.\n");
    }
    }while(n <= 0 || n > MAX);
// entrada de datos y verificacion de que cumplan los parametros
    printf("Ingrese %d elementos (solo mayores a 0):\n", n);
    for (int i = 0; i < n; i++) {
        do{
        printf("\n v[%d] = ", i);
        scanf("%d", &v[i]);
        if(v[i]<=0){
            printf("\nerror: no es mayor 0");
          }
          //esto se usa para que no se salga del programa
        }while(v[i]<=0);
    }


    printf("\nVector ingresado:\n[ ");
    for (int i = 0; i < n; i++) {
        printf("%d ", v[i]);
    }
    printf("]\n");
}

//funcion para la matriz
void gestionar_matriz() {
    int filas, cols;
    float m[MAX][MAX];

    printf("\n--- MATRIZ N x M ---\n");
    do{
    printf("Ingrese el numero de filas (1 a %d): ", MAX);
    scanf("%d", &filas);
    if(filas <= 0 || filas > MAX){
        printf("\nsolo numeros mayores que 0 \n");
    }
    }while(filas <= 0 || filas > MAX);

    do{
    printf("Ingrese el numero de columnas (1 a %d): ", MAX);
    scanf("%d", &cols);
    if(cols <= 0 || cols > MAX){
        printf("\ntiene que ser mayor que 0 \n");
    }
    }while(cols <= 0 || cols > MAX);


    printf("Ingrese los elementos de la matriz (pueden ser decimales mayores a 0):\n");
    for (int i = 0; i < filas; i++) {
        for (int j = 0; j < cols; j++) {
            do{
            printf("\n m[%d][%d] = ", i, j);
            scanf("%f", &m[i][j]);
            if (m[i][j]<=0){
                printf("\n error: solo mayores a 0");
            }
            }while (m[i][j]<=0);
        }
    }

    printf("\nMatriz ingresada:\n");
    for (int i = 0; i < filas; i++) {
        for (int j = 0; j < cols; j++) {
            printf("%.2f\t", m[i][j]);
        }
        printf("\n");
    }
}

