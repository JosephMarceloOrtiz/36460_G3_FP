void ValidarFecha() {
    int anio, mes, dia;
    int diasMaximos = 0;


    do {
        printf("\nIngrese el anio (1900-2015): ");
        scanf("%d", &anio);
        if (anio < 1900 || anio > 2015) {
            printf("Anio fuera de rango. Intente nuevamente.\n");
        }
    } while (anio < 1900 || anio > 2015);


    do {
        printf("Ingrese el mes (1-12): ");
        scanf("%d", &mes);
        if (mes < 1 || mes > 12) {
            printf("Mes invalido. Intente nuevamente.\n");
        }
    } while (mes < 1 || mes > 12);


    switch (mes) {
        case 1:
        case 3:
        case 5:
        case 7:
        case 8:
        case 10:
        case 12:
            diasMaximos = 31;
            break;
        case 4:
        case 6:
        case 9:
        case 11:
            diasMaximos = 30;
            break;
        case 2:
            diasMaximos = 29;
            break;
    }


    do {
        printf("Ingrese el dia (1-%d): ", diasMaximos);
        scanf("%d", &dia);
        if (dia < 1 || dia > diasMaximos) {
            printf("Dia fuera del rango para este mes. Intente nuevamente.\n");
        }
    } while (dia < 1 || dia > diasMaximos);


    char *nombreMes = "";
    switch (mes) {
        case 1:  nombreMes = "enero"; break;
        case 2:  nombreMes = "febrero"; break;
        case 3:  nombreMes = "marzo"; break;
        case 4:  nombreMes = "abril"; break;
        case 5:  nombreMes = "mayo"; break;
        case 6:  nombreMes = "junio"; break;
        case 7:  nombreMes = "julio"; break;
        case 8:  nombreMes = "agosto"; break;
        case 9:  nombreMes = "septiembre"; break;
        case 10: nombreMes = "octubre"; break;
        case 11: nombreMes = "noviembre"; break;
        case 12: nombreMes = "diciembre"; break;
    }

    printf("\nFecha ingresada exitosamente:\n");
    printf(">> %d de %s de %d <<\n", dia, nombreMes, anio);
}

void SerieLetras() {
    int terminos;

    do {
        printf("\nIngrese la cantidad de terminos (mayor que 0): ");
        scanf("%d", &terminos);
        if (terminos <= 0) {
            printf("La cantidad de terminos debe ser mayor que cero. Intente nuevamente.\n");
        }
    } while (terminos <= 0);

    printf("\n");

    for (int i = 0; i < terminos; i++) {
        char superior = 'a' + (2 * i);
        if (superior <= 'z') {
            printf("%c ", superior);
        } else {
            printf("  ");
        }
    }
    printf("\n");

    for (int i = 0; i < terminos; i++) {
        printf("- ");
    }
    printf("\n");

    for (int i = 0; i < terminos; i++) {
        char inferior = 'b' + (2 * i);
        if (inferior <= 'z') {
            printf("%c ", inferior);
        } else {
            printf("  ");
        }
    }
    printf("\n");
}

void SerieNumeros() {
    int terminos;

    // Reinicio en cada llamada a la funcion
    int sub1 = 1;
    int sub2 = 5;

    do {
        printf("\nIngrese la cantidad de terminos (0 o mayor): ");
        scanf("%d", &terminos);
        if (terminos < 0) {
            printf("La cantidad de terminos no puede ser negativa. Intente nuevamente.\n");
        }
    } while (terminos < 0);

    printf("\n");

    if (terminos == 0) {
        printf("Serie vacia (0 terminos).\n");
        return;
    }

    int parejas = terminos / 2;
    int esImpar = (terminos % 2 != 0);

    for (int i = 0; i < parejas; i++) {
        printf("%d", sub1);
        if (i < parejas - 1 || esImpar) {
            printf(", ");
        }
        printf("%d", sub2);
        if (i < parejas - 1) {
            printf(", ");
        }
        sub1 += 2;
        sub2 += 2;
    }

    if (esImpar) {
        printf("%d", sub1);
    }

    printf("\n");
}

