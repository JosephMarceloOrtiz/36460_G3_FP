#include <stdio.h>
#define MAX 10

// Declara la función gestionar_vector que no devuelve ningún valor (void)
void gestionar_vector() {
    int n;
    int v[MAX];

    printf("\n--- VECTOR DE TAMANO N ---\n");

    // do-while. Sirve para pedir el tamaño del vector al menos una vez y repetir la pregunta las veces que sea necesario.
    do {
        printf("Ingrese el tamano del vector (1 a %d): ", MAX);

        // Intenta leer un número entero y guardarlo en n.
        if (scanf("%d", &n) != 1) {
            printf("Error: Debe ingresar un numero entero.\n");

            // Lee y descarta para evitar un bucle infinito.
            while (getchar() != '\n');

            //Sirve para asegurar que la condición del while n <= 0 se cumpla y obligue a repetir el ciclo
            n = 0;
            //Validar el tamaño
            } else if (n <= 0 || n > MAX) { 
            printf("Error: El tamano debe ser mayor a 0 y maximo %d.\n", MAX);
        }

    // sirve para el ciclo vuelve a empezar sin salirse al menú
    } while (n <= 0 || n > MAX);
    printf("Ingrese %d elementos (solo positivos mayores a 0):\n", n);

    // Inicia un ciclo 'for' con un contador 'i' desde 0 hasta n-1. Sirve para recorrer cada casilla del vector una por una.
    for (int i = 0; i < n; i++) {
        // ciclo do-while. Sirve para ingresar un dato válido.
        do {
            // Muestra la posición exacta que se está llenando (ej. v[0] = ). Sirve para que el usuario sepa qué índice está capturando.
            printf("v[%d] = ", i);

            // Intenta leer el entero y guardarlo en la posición 'i' del vector. Verifica que realmente sea un número.
            if (scanf("%d", &v[i]) != 1) {
                // Muestra error si se ingresaron letras. Sirve para notificar la entrada inválida.
                printf("Error: Debe ingresar un numero entero.\n");

                // Limpia la memoria temporal del teclado (buffer). Sirve para eliminar las letras erróneas y que el siguiente scanf funcione bien.
                while (getchar() != '\n');

                // Guarda un 0 en la posición actual. Sirve para forzar a que el ciclo 'while' repita la lectura de este mismo índice.
                v[i] = 0;
            // Si sí escribió un número, verifica que no sea 0 ni negativo (<= 0). Sirve para cumplir la regla de aceptar únicamente valores estrictamente positivos.
            } else if (v[i] <= 0) {
                // Informa que el 0 y los negativos están prohibidos. Sirve para que el usuario corrija su entrada.
                printf("Error: No se permite el 0 ni negativos. Intente de nuevo.\n");
            }
        // Condición: si el valor guardado en v[i] es menor o igual a 0, repite la petición para esa misma casilla.
        } while (v[i] <= 0);
    }

    // Imprime un encabezado y un corchete de apertura. Sirve para darle formato visual a la salida de datos.
    printf("\nVector ingresado:\n[ ");

    // Recorre nuevamente el vector desde 0 hasta n-1. Sirve para leer todos los datos ya guardados y mostrarlos.
    for (int i = 0; i < n; i++) {
        // Imprime el valor de la posición 'i' seguido de un espacio. Sirve para mostrar los números en una sola línea separados entre sí.
        printf("%d ", v[i]);
    }
    // Imprime el corchete de cierre y un salto de línea. Sirve para terminar la presentación visual del vector.
    printf("]\n");
}

// Declara la función gestionar_matriz. Sirve para agrupar todo el proceso de pedir dimensiones, llenar e imprimir la matriz.
void gestionar_matriz() {
    // Declara dos variables enteras 'filas' y 'cols'. Sirven para guardar el alto y el ancho de la matriz elegidos por el usuario.
    int filas, cols;

    // Declara una matriz bidimensional 'm' de tipo flotante (decimales) de 10x10. Sirve para almacenar los valores en formato de tabla.
    float m[MAX][MAX];

    // Imprime el título de la sección de matriz. Sirve para orientar al usuario en la pantalla.
    printf("\n--- MATRIZ N x M ---\n");

    // Inicia un ciclo do-while exclusivo para las filas. Sirve para validar las filas de forma independiente a las columnas.
    do {
        // Pide al usuario la cantidad de filas. Sirve para solicitar la primera dimensión.
        printf("Ingrese el numero de filas (1 a %d): ", MAX);

        // Verifica si el usuario ingresó un número entero válido. Sirve para atrapar errores si escribe texto.
        if (scanf("%d", &filas) != 1) {
            // Muestra mensaje de error de formato.
            printf("Error: Debe ingresar un numero entero.\n");
            // Limpia el teclado de caracteres basura.
            while (getchar() != '\n');
            // Asigna 0 a filas para forzar la repetición del bucle.
            filas = 0;
            // Salta al 'while' para volver a pedir el dato.
            continue;
        }
        // Comprueba que las filas no sean 0, negativas ni mayores a 10. Sirve para mantener las dimensiones dentro del rango válido.
        if (filas <= 0 || filas > MAX) {
            // Avisa que el número está fuera de rango.
            printf("Error: Las filas deben ser mayores a 0 y maximo %d.\n", MAX);
        }
    // Repite la petición de filas mientras el valor sea menor o igual a 0, o mayor a 10.
    } while (filas <= 0 || filas > MAX);

    // Inicia un segundo ciclo do-while exclusivo para las columnas. Sirve para que, si falla aquí, no tenga que volver a escribir las filas.
    do {
        // Pide al usuario la cantidad de columnas. Sirve para solicitar la segunda dimensión.
        printf("Ingrese el numero de columnas (1 a %d): ", MAX);

        // Verifica que la entrada sea un número entero.
        if (scanf("%d", &cols) != 1) {
            // Avisa que debe escribir un número.
            printf("Error: Debe ingresar un numero entero.\n");
            // Limpia el buffer de entrada.
            while (getchar() != '\n');
            // Asigna 0 para forzar la repetición.
            cols = 0;
            // Salta a la evaluación del ciclo.
            continue;
        }
        // Comprueba que las columnas estén entre 1 y 10.
        if (cols <= 0 || cols > MAX) {
            // Muestra error si puso 0, negativo o más de 10.
            printf("Error: Las columnas deben ser mayores a 0 y maximo %d.\n", MAX);
        }
    // Repite la petición de columnas mientras no sea un número válido entre 1 y 10.
    } while (cols <= 0 || cols > MAX);

    // Indica que comenzará el llenado de la matriz. Sirve para avisar al usuario que solo se aceptan positivos.
    printf("Ingrese los elementos de la matriz (solo positivos mayores a 0):\n");

    // Ciclo 'for' externo que recorre las filas (índice 'i'). Sirve para moverse verticalmente por la matriz.
    for (int i = 0; i < filas; i++) {
        // Ciclo 'for' interno que recorre las columnas (índice 'j') de la fila actual. Sirve para moverse horizontalmente celda por celda.
        for (int j = 0; j < cols; j++) {
            // Ciclo do-while para validar cada celda individualmente. Sirve para no avanzar de celda hasta que el número sea positivo.
            do {
                // Muestra las coordenadas actuales (ej. m[0][1] = ). Sirve para que el usuario sepa exactamente en qué posición está guardando el dato.
                printf("m[%d][%d] = ", i, j);

                // Lee un número decimal (%f) y verifica que la lectura sea exitosa. Sirve para capturar tanto enteros como decimales.
                if (scanf("%f", &m[i][j]) != 1) {
                    // Muestra error si se escribieron letras.
                    printf("Error: Debe ingresar un numero valido.\n");
                    // Limpia el teclado.
                    while (getchar() != '\n');
                    // Asigna 0.0 flotante a la celda para obligar a repetir el ciclo.
                    m[i][j] = 0.0f;
                // Verifica si el número ingresado es menor o igual a 0. Sirve para rechazar ceros y números negativos.
                } else if (m[i][j] <= 0) {
                    // Muestra el mensaje de advertencia al usuario.
                    printf("Error: No se permite ceros ni negativos. Intente de nuevo.\n");
                }
            // Condición: repite la captura de la celda [i][j] mientras el valor sea menor o igual a 0.
            } while (m[i][j] <= 0);
        }
    }

    // Imprime el encabezado de resultados. Sirve para separar la captura de datos de la visualización final.
    printf("\nMatriz ingresada:\n");

    // Ciclo externo para recorrer las filas al imprimir.
    for (int i = 0; i < filas; i++) {
        // Ciclo interno para recorrer las columnas de cada fila al imprimir.
        for (int j = 0; j < cols; j++) {
            // Imprime el número con exactamente 2 decimales (%.2f) seguido de una tabulación (\t). Sirve para que las columnas queden alineadas como una tabla.
            printf("%.2f\t", m[i][j]);
        }
        // Imprime un salto de línea al terminar cada fila. Sirve para bajar al siguiente renglón y dar forma bidimensional a la matriz.
        printf("\n");
    }
}

// Función principal del programa. Sirve como punto de arranque donde comienza a ejecutarse todo el código.
int main() {
    // Declara la variable entera 'opcion'. Sirve para guardar el número que el usuario elija en el menú.
    int opcion;

    // Inicia el ciclo principal del menú. Sirve para que el programa siga funcionando y mostrando opciones hasta que el usuario decida salir.
    do {
        // Imprime una línea decorativa superior. Sirve para dar estructura visual al menú.
        printf("\n====================\n");
        // Imprime el título del menú.
        printf("       MENU         \n");
        // Imprime una línea decorativa inferior.
        printf("====================\n");
        // Muestra la primera opción disponible.
        printf("1. Vector de tamano N\n");
        // Muestra la segunda opción disponible.
        printf("2. Matriz N x M\n");
        // Muestra la tercera opción para finalizar el programa.
        printf("3. Salida\n");
        // Solicita al usuario que escriba su elección.
        printf("Seleccione una opcion: ");

        // Lee la opción del usuario y verifica que sea un número entero. Sirve para proteger el menú si el usuario teclea letras por accidente.
        if (scanf("%d", &opcion) != 1) {
            // Limpia los caracteres inválidos del teclado.
            while (getchar() != '\n');
            // Asigna 0 a 'opcion'. Sirve para que el 'switch' caiga automáticamente en el caso 'default' y muestre el error.
            opcion = 0;
        }

        // Estructura switch que evalúa el valor de 'opcion'. Sirve para dirigir el flujo del programa hacia la función elegida.
        switch(opcion) {
            // Si 'opcion' vale 1:
            case 1:
                // Ejecuta todo el bloque de código del vector.
                gestionar_vector();
                // Detiene el switch al terminar la función. Sirve para evitar que se ejecuten los casos de abajo.
                break;
            // Si 'opcion' vale 2:
            case 2:
                // Ejecuta todo el bloque de código de la matriz.
                gestionar_matriz();
                // Detiene el switch al terminar la función.
                break;
            // Si 'opcion' vale 3:
            case 3:
                // Muestra un mensaje de despedida antes de cerrar.
                printf("Saliendo del programa...\n");
                // Detiene el switch.
                break;
            // Si 'opcion' tiene cualquier otro número distinto de 1, 2 o 3:
            default:
                // Informa al usuario que eligió una opción inexistente.
                printf("Opcion invalida. Intente de nuevo.\n");
        }
    // Condición del menú: mientras la opción sea distinta de 3, vuelve a mostrar el menú principal.
    } while(opcion != 3);

    // Devuelve 0 al sistema operativo. Sirve para indicar que el programa terminó su ejecución correctamente y sin fallos.
    return 0;
}
